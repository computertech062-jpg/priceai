# ئەم فایلە کۆپی بکە بۆ .env و بەهاکان بگۆڕە

# کلیلی نهێنی بۆ JWT (هەر دەقێکی درێژ و هەڕەمەکی)
SECRET_KEY=change-me-to-a-long-random-string

# بنکەی زانیاری. بنەڕەت SQLite یە (پێویستی بە دامەزراندن نییە)
# DATABASE_URL=sqlite:///./priceai.db
# بۆ PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/priceai

# هەژماری Admin (ئارەزوومەندانە). ڕێگەی باشتر:  python scripts/create_admin.py you@gmail.com
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=a-strong-password

# چوونەژوورەوە پێویستە بۆ بەکارهێنانی سیستەمەکە (بنەڕەت: 1). بۆ ڕێگەدان بە میوان: 0
# REQUIRE_LOGIN=1

# فایلی داتا (بنەڕەت: data/phones.csv، ئەگەر نەبوو داتای نموونەیی)
# DATA_PATH=data/phones.csv
